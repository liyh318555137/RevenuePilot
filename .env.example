DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-flash
DATABASE_URL=postgresql://sales_agent:sales_agent_dev@localhost:5432/sales_agent
LANGGRAPH_STRICT_MSGPACK=true
KNOWLEDGE_BASE_ENABLED=false
SALES_TENANT_ID=default
# OpenAI-compatible embedding endpoint; do not use the chat-only DeepSeek key here
EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
# Fixed once the knowledge table is created; changing it requires re-ingesting
EMBEDDING_DIMENSIONS=1536
# Judge model for eval_live.py; use a different model from DEEPSEEK_MODEL to avoid self-review bias
REVIEWER_MODEL=deepseek-flash
